# Secrets and local configuration
.env
.env.*
!.env.example
.secrets/
secrets/
*.key
*.pem
*.p12
*.pfx

# Python and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build, runtime, and evidence outputs.
# Exception: per-chapter lab evidence under build/chNN/ is versioned alongside the code
# that produced it, because every lab README links to it. Runtime scratch stays ignored.
build/*
!build/ch[0-9][0-9]/
build/*/runtime/
build/*/runtime-mcp/
build/*/verification-runtime/
build/*/verification-runtime-mcp/
build/*/debug-extension/
dist/
site/
tmp/
temp/
logs/
*.log
evidence/
artifacts/generated/

# Local databases, queues, and caches
*.db
*.sqlite
*.sqlite3
*.rdb

# Model and dataset artifacts
models/
checkpoints/
*.gguf
*.safetensors
*.onnx
data/private/
data/raw/

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
.codegraph/

# Local test and coverage state
.tox/
.nox/
.hypothesis/
# Root-only: lab evidence junit.xml under build/chNN/ is intentionally tracked.
/junit.xml
